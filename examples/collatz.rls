fn steps(start: Int) -> Int {
    let mut n = start
    let mut count = 0
    while n != 1 {
        if n % 2 == 0 {
            n = n / 2
        } else {
            n = 3 * n + 1
        }
        count = count + 1
    }
    count
}

fn main() {
    println(steps(27))
    println(steps(97))
    println(steps(871))
}
