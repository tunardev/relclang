fn max(a: Int, b: Int) -> Int {
    if a > b { a } else { b }
}

fn classify(n: Int) -> Str {
    if n < 0 {
        "negative"
    } else if n == 0 {
        "zero"
    } else {
        "positive"
    }
}

fn sum_to(n: Int) -> Int {
    let mut total = 0
    let mut i = 1
    while i <= n {
        total = total + i
        i = i + 1
    }
    total
}

fn fib(n: Int) -> Int {
    let mut a = 0
    let mut b = 1
    let mut k = 0
    while k < n {
        let next = a + b
        a = b
        b = next
        k = k + 1
    }
    a
}

fn main() {
    println(max(3, 9))
    println(classify(-5))
    println(classify(0))
    println(classify(7))
    println(true and not false)
    println(1 == 1 or false)
    println(sum_to(10))
    println(fib(10))
}
